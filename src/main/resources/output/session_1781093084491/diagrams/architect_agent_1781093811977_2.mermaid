flowchart LR
    subgraph "Source Control (GitLab)"
        DEV_BRANCH[Feature Branches]
        MAIN_BRANCH[main branch]
        TAG[Release Tags\nv1.0.0]
    end

    subgraph "CI Pipeline (GitLab CI)"
        direction TB
        BUILD[🔨 Build\nCompile + Unit Tests\n5 min]
        TEST[🧪 Test\nIntegration Tests\nContract Tests\nSonarQube Gate\nArchUnit Tests\n15 min]
        PACKAGE[📦 Package\nDocker Build\nSecurity Scan\nPush to Registry\n5 min]
    end

    subgraph "CD Pipeline (GitLab CI)"
        direction TB
        DEPLOY_DEV[🚀 Deploy Dev\nAuto on main merge\n2 min]
        APPROVE_STAGING{Manual Approval}
        DEPLOY_STAGING[🚀 Deploy Staging\n2 min]
        E2E_TESTS[🧪 E2E Tests]
        APPROVE_PROD{Manual Approval}
        DEPLOY_PROD[🚀 Deploy Prod\n2 min]
        SMOKE_TESTS[🧪 Smoke Tests]
    end

    subgraph "Environments"
        DEV[Dev K8s Namespace]
        STAGING[Staging K8s Namespace]
        PROD[Production K8s Namespace]
    end

    subgraph "Quality Gates"
        SONAR[SonarQube\nCoverage ≥ 80%\nNo Critical Issues]
        CONTRACT[Pact Broker\nContract Verification]
        SECURITY[Trivy\nContainer Security]
        HEALTH[Health Checks\nLiveness + Readiness]
    end

    DEV_BRANCH -->|"MR"| MAIN_BRANCH
    MAIN_BRANCH --> BUILD
    BUILD --> TEST
    TEST --> SONAR
    TEST --> CONTRACT
    TEST --> PACKAGE
    PACKAGE --> SECURITY
    PACKAGE --> DEPLOY_DEV
    DEPLOY_DEV --> DEV
    DEV --> HEALTH
    
    DEV --> APPROVE_STAGING
    APPROVE_STAGING -->|"Approved"| DEPLOY_STAGING
    DEPLOY_STAGING --> STAGING
    STAGING --> E2E_TESTS
    
    E2E_TESTS --> APPROVE_PROD
    APPROVE_PROD -->|"Approved"| DEPLOY_PROD
    DEPLOY_PROD --> PROD
    PROD --> SMOKE_TESTS

    TAG --> BUILD