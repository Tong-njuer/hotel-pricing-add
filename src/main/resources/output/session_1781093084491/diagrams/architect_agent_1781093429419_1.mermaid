C4Context
    title System Context diagram for Hotel Pricing System

    Person(commercialUser, "Commercial User", "Manages hotel pricing")
    Person(admin, "Administrator", "Manages hotels, rates, and users")

    System(hps, "Hotel Pricing System", "Manages hotel pricing with CQRS and event-driven architecture")

    System_Ext(identityService, "User Identity Service", "Cloud provider identity service")
    System_Ext(channelMgmt, "Channel Management System", "External system receiving price changes")
    System_Ext(extQuery, "External Query Systems", "External systems querying hotel prices")

    Rel(commercialUser, hps, "Uses web browser", "HTTPS")
    Rel(admin, hps, "Uses web browser", "HTTPS")
    Rel(hps, identityService, "Validates credentials", "REST/HTTPS")
    Rel(hps, channelMgmt, "Publishes price changes", "REST/HTTPS")
    Rel(extQuery, hps, "Queries hotel prices", "REST/HTTPS")