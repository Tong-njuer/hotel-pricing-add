flowchart TD
    subgraph "Price Calculation Module"
        direction TB
        PCC[PriceChangeCommandConsumer]
        PCV[PriceChangeValidator]
        PCA[PriceChangeApplier]
        RCE[RateCalculationEngine]
        
        subgraph "Transactional Outbox"
            OPS[OutboxPollingService]
            OT[(Outbox Table\nwrite_model schema)]
        end
        
        PCA -->|"1. Write price + event\n(same transaction)"| OT
        OPS -->|"2. Poll unpublished events"| OT
        OPS -->|"3. Publish to Kafka"| KAFKA
    end

    subgraph "Kafka"
        CMD[price-change-commands]
        EVT[price-change-events]
        DLQ[price-change-events-dlq]
    end

    subgraph "Channel Management Publisher"
        direction TB
        PEC[PriceEventConsumer]
        IC[IdempotencyChecker]
        CB1[CircuitBreaker]
        CPS[ChannelPushService]
        RH[RetryHandler\nExponential Backoff]
        
        PEC --> IC
        IC --> CB1
        CB1 -->|"closed"| CPS
        CPS -->|"failure"| RH
        RH -->|"retry"| CPS
        RH -->|"max retries"| DLQ
    end

    subgraph "External System"
        CMS[Channel Management System]
    end

    subgraph "Monitoring"
        PROM[Prometheus]
        GRAF[Grafana Dashboards]
        LOG[Log Aggregation]
    end

    KAFKA -->|"consume"| PEC
    CPS -->|"REST API"| CMS
    
    %% Metrics collection
    PCC -.->|"metrics"| PROM
    OPS -.->|"metrics"| PROM
    PEC -.->|"metrics"| PROM
    CPS -.->|"metrics"| PROM
    CB1 -.->|"state"| PROM
    PROM --> GRAF
    PCC -.->|"logs"| LOG
    PEC -.->|"logs"| LOG