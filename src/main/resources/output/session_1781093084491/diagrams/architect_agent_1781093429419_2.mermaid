C4Container
    title Container Diagram for Hotel Pricing System (Final)

    Person(commercialUser, "Commercial User", "Web browser")
    Person(admin, "Administrator", "Web browser")

    System_Boundary(hps, "Hotel Pricing System") {
        Container(spa, "Angular SPA", "Angular", "Single-page application")

        Container(gateway, "API Gateway", "Spring Boot (Java)", "Entry point, auth, hybrid sync/async routing, tracking ID management")

        Boundary(commandSide, "Command Side") {
            Container(priceCalc, "Price Calculation Module", "Spring Boot (Java)", "Processes price changes, Rate Calculation Engine (HPS-5 business rules)")
        }

        Boundary(querySide, "Query Side") {
            Container(queryMod, "Query Module", "Spring Boot (Java)", "Reads from read model, serves queries")
        }

        Container(hotelMgmt, "Hotel Management Module", "Spring Boot (Java)", "Hotel info, tax rates, room types, user permissions")

        ContainerDb(db, "PostgreSQL Database", "PostgreSQL", "Single instance: write_model schema + read_model schema (materialized view)")

        Container(kafka, "Kafka Event Bus", "Apache Kafka", "Topics: price-change-commands, price-change-events")

        Container(channelPub, "Channel Management Publisher", "Spring Boot (Java)", "Consumes events, pushes to external system (post-MVP)")
    }

    System_Ext(identityService, "User Identity Service", "Cloud provider")
    System_Ext(channelMgmt, "Channel Management System", "External system")
    System_Ext(extQuery, "External Query Systems", "External systems")

    Rel(commercialUser, spa, "Uses", "HTTPS")
    Rel(admin, spa, "Uses", "HTTPS")
    Rel(spa, gateway, "Makes API calls", "REST/HTTPS")

    Rel(gateway, identityService, "Validates credentials", "REST/HTTPS")

    Rel(gateway, kafka, "Publishes price change commands", "Kafka Producer (topic: price-change-commands)")
    Rel(priceCalc, kafka, "Consumes commands, publishes events", "Kafka Consumer/Producer (topic: price-change-events)")

    Rel(gateway, queryMod, "Queries prices (sync)", "Internal REST")
    Rel(queryMod, db, "Reads from read_model schema", "JDBC/JPA")

    Rel(priceCalc, db, "Writes to write_model schema", "JDBC/JPA")
    Rel(hotelMgmt, db, "Reads/Writes hotel data", "JDBC/JPA")

    Rel(queryMod, kafka, "Consumes price change events to update read model", "Kafka Consumer (topic: price-change-events)")

    Rel(channelPub, kafka, "Consumes events (post-MVP)", "Kafka Consumer (topic: price-change-events)")
    Rel(channelPub, channelMgmt, "Pushes price changes (post-MVP)", "REST/HTTPS")

    Rel(extQuery, gateway, "Queries prices", "REST/HTTPS")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="2")