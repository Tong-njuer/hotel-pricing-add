flowchart TD
    subgraph "External Protocol Layer"
        REST[External System\nREST Client]
        GRPC[External System\ngRPC Client]
    end

    subgraph "API Gateway"
        direction TB
        subgraph "Protocol Adapter Layer"
            REST_EP[REST Endpoint\n/api/external/prices]
            GRPC_EP[gRPC Service\nPriceQueryService\nProtocolAdapter]
        end
        
        subgraph "Core Gateway Layer"
            AF[AuthFilter]
            AS[AuthorizationService]
            SR[SyncRouter]
            RL[RateLimiter]
        end
        
        subgraph "Internal Service Interface"
            IQI[InternalQueryApi\nInterface - UNCHANGED]
        end
    end

    subgraph "Query Module - UNCHANGED"
        IQI_IMPL[InternalQueryApi\nImplementation]
        RMR[ReadModelRepository]
        RM[(Read Model\nPostgreSQL)]
    end

    REST -->|"REST/HTTPS"| REST_EP
    GRPC -->|"gRPC/HTTP2"| GRPC_EP
    
    REST_EP --> AF
    GRPC_EP --> AF
    
    AF --> AS
    AS --> SR
    SR --> RL
    
    RL --> IQI
    
    GRPC_EP -->|"CALLS SAME INTERFACE"| IQI
    
    IQI --> IQI_IMPL
    IQI_IMPL --> RMR
    RMR --> RM

    style IQI fill:#4CAF50,color:white
    style IQI_IMPL fill:#4CAF50,color:white
    style RMR fill:#4CAF50,color:white
    style RM fill:#4CAF50,color:white
    
    style GRPC_EP fill:#FF9800,color:white
    style REST_EP fill:#2196F3,color:white