flowchart TD
    subgraph "Angular SPA"
        UI[User Interface]
    end

    subgraph "API Gateway"
        AF[AuthFilter]
        AS[AuthorizationService]
        AR[AsyncRouter]
        TM[TrackingIdManager]
        SE[StatusEndpoint]
    end

    subgraph "Kafka Event Bus"
        CMD[price-change-commands topic]
        EVT[price-change-events topic]
    end

    subgraph "Price Calculation Module"
        PCC[PriceChangeCommandConsumer]
        PCV[PriceChangeValidator]
        PS[PriceSimulator]
        RCE[RateCalculationEngine]
        PCA[PriceChangeApplier]
        PEP[PriceEventPublisher]
        SRC[SimulationResultCache]
        RRR[RateRuleRepository]
    end

    subgraph "PostgreSQL Database"
        WM[(write_model schema)]
        RM[(read_model schema)]
    end

    subgraph "Query Module"
        RMP[ReadModelProjector]
    end

    subgraph "Channel Management Publisher"
        PEC[PriceEventConsumer]
        CPS[ChannelPushService]
        RH[RetryHandler]
        DLQ[(Dead Letter Queue)]
        IC[IdempotencyChecker]
    end

    subgraph "External Systems"
        CMS[Channel Management System]
    end

    %% Simulation Path
    UI -->|"POST /api/prices/simulate"| AF
    AF -->|"Validate JWT"| AS
    AS -->|"Check hotel auth"| AR
    AR -->|"Publish with tracking ID"| CMD
    CMD -->|"Consume"| PCC
    PCC -->|"Simulate path"| PS
    PS -->|"Calculate"| RCE
    RCE -->|"Fetch rules"| RRR
    RRR -->|"Rules"| WM
    PS -->|"Cache result"| SRC
    PCC -->|"Return tracking ID"| SE
    UI -->|"Poll status"| SE

    %% Apply Path
    UI -->|"POST /api/prices/apply"| AF
    AF --> AS --> AR --> CMD
    CMD -->|"Consume"| PCC
    PCC -->|"Apply path"| PCA
    PCA -->|"Validate"| PCV
    PCA -->|"Calculate"| RCE
    PCA -->|"Write"| WM
    PCA -->|"Publish event"| PEP
    PEP -->|"Publish"| EVT

    %% Read Model Update
    EVT -->|"Consume"| RMP
    RMP -->|"Refresh"| RM

    %% Channel Management Push
    EVT -->|"Consume"| PEC
    PEC -->|"Check duplicate"| IC
    PEC -->|"Push"| CPS
    CPS -->|"REST API"| CMS
    CPS -->|"On failure"| RH
    RH -->|"Max retries exceeded"| DLQ
    RH -->|"Retry"| CPS