flowchart TD
    subgraph "API Gateway"
        CB_GW_QM[Circuit Breaker\n→ Query Module\nThreshold: 50% in 10s\nOpen: 30s]
        CB_GW_HM[Circuit Breaker\n→ Hotel Mgmt Module\nThreshold: 50% in 10s\nOpen: 30s]
        CB_GW_PC[Circuit Breaker\n→ Price Calc (via Kafka)\nThreshold: N/A (async)]
    end

    subgraph "Query Module"
        CB_QM_DB[Circuit Breaker\n→ PostgreSQL Read Replica\nThreshold: 30% in 10s\nOpen: 60s\nFallback: return cached data]
    end

    subgraph "Channel Management Publisher"
        CB_CMP_CMS[Circuit Breaker\n→ Channel Mgmt System\nThreshold: 50% in 10s\nOpen: 30s\nFallback: retry later]
    end

    subgraph "Price Calculation Module"
        CB_PC_DB[Circuit Breaker\n→ PostgreSQL Primary\nThreshold: 30% in 10s\nOpen: 60s]
    end

    subgraph "Hotel Management Module"
        CB_HM_DB[Circuit Breaker\n→ PostgreSQL Primary\nThreshold: 30% in 10s\nOpen: 60s]
    end

    GW --> CB_GW_QM
    GW --> CB_GW_HM
    QM --> CB_QM_DB
    CMP --> CB_CMP_CMS
    PCM --> CB_PC_DB
    HMM --> CB_HM_DB