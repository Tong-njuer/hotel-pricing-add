flowchart TD
    subgraph "System Boundary"
        direction TB
        
        subgraph "API Gateway Tests"
            GW_UNIT[Unit Tests\nJUnit + Mockito\nRouting logic, Auth logic]
            GW_INT[Integration Tests\nTestcontainers + WireMock\nAuth flow with mock Identity Service]
            GW_CONTRACT[Contract Tests\nPact Consumer\nDefines expectations from Query Module]
        end
        
        subgraph "Price Calculation Module Tests"
            PCM_UNIT[Unit Tests\nJUnit + Mockito\nRateCalculationEngine rules]
            PCM_INT[Integration Tests\nTestcontainers\nPostgreSQL + Kafka\nOutbox pattern]
            PCM_CONTRACT[Contract Tests\nPact Provider\nVerifies API Gateway expectations]
        end
        
        subgraph "Query Module Tests"
            QM_UNIT[Unit Tests\nJUnit + Mockito\nQuery logic, formatting]
            QM_INT[Integration Tests\nTestcontainers\nPostgreSQL read model\nRead replica queries]
            QM_CONTRACT[Contract Tests\nPact Provider\nVerifies API Gateway expectations]
        end
        
        subgraph "Hotel Management Module Tests"
            HM_UNIT[Unit Tests\nJUnit + Mockito\nCRUD logic, validation]
            HM_INT[Integration Tests\nTestcontainers\nPostgreSQL data access]
        end
        
        subgraph "Channel Management Publisher Tests"
            CMP_UNIT[Unit Tests\nJUnit + Mockito\nRetry logic, idempotency]
            CMP_INT[Integration Tests\nTestcontainers + WireMock\nKafka + mock CMS]
            CMP_CONTRACT[Contract Tests\nPact Consumer\nDefines expectations from CMS]
        end
        
        subgraph "Angular SPA Tests"
            SPA_UNIT[Unit Tests\nJasmine + Karma\nComponent rendering]
            SPA_INT[Integration Tests\nCypress\nUI flow with mock API]
        end
        
        subgraph "Infrastructure Tests"
            INFRA_TEST[Infrastructure Tests\nkind + Terratest\nK8s manifest validation\nHelm chart testing]
        end
    end

    subgraph "Test Doubles"
        TC_PG[Testcontainers\nPostgreSQL]
        TC_KAFKA[Testcontainers\nKafka / Embedded Kafka]
        WM[WireMock\nExternal APIs\nIdentity Service\nChannel Mgmt System]
        PACT[Pact Broker\nContract Verification]
        MOCK[Mockito\nInternal dependencies]
    end

    GW_INT --> WM
    PCM_INT --> TC_PG
    PCM_INT --> TC_KAFKA
    QM_INT --> TC_PG
    HM_INT --> TC_PG
    CMP_INT --> TC_KAFKA
    CMP_INT --> WM
    SPA_INT --> WM
    
    GW_CONTRACT --> PACT
    PCM_CONTRACT --> PACT
    QM_CONTRACT --> PACT
    CMP_CONTRACT --> PACT
    
    GW_UNIT --> MOCK
    PCM_UNIT --> MOCK
    QM_UNIT --> MOCK
    HM_UNIT --> MOCK
    CMP_UNIT --> MOCK